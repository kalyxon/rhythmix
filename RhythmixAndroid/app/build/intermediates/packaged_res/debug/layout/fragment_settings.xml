<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingStart="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Folder card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_card_accent" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:layout_gravity="center" android:src="@drawable/ic_folder"
                            app:tint="@color/black"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Music Folder" android:textSize="13sp" android:textColor="@color/text_tertiary"/>
                        <TextView android:id="@+id/tv_folder_path"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                            android:maxLines="1" android:ellipsize="end"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/tv_folder_uri"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/text_tertiary"
                    android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="16dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Songs" android:textSize="10sp" android:textColor="@color/text_tertiary"/>
                        <TextView android:id="@+id/tv_song_count"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/accent"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Play Events" android:textSize="10sp" android:textColor="@color/text_tertiary"/>
                        <TextView android:id="@+id/tv_event_count"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/violet"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btn_change_folder"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Change Music Folder"
                android:backgroundTint="@color/surface" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <Button android:id="@+id/btn_rescan"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Rescan Folder"
                android:backgroundTint="@color/surface" android:textColor="@color/text_primary"
                android:layout_marginBottom="20dp" />

            <!-- Privacy card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="10dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Privacy &amp; Data"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tv_data_file"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="@color/accent"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/tv_data_note"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <Button android:id="@+id/btn_clear_data"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Clear Listening History"
                android:backgroundTint="@color/red_dim" android:textColor="@color/red" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
