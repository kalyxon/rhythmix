<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Read media (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Wakelock to keep playback alive when screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_theme_emerald"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_theme_emerald"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rhythmix">

        <!-- Theme-specific launcher entries keep the launcher and system splash in sync. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".ui.MainActivityEmerald"
            android:targetActivity=".ui.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_emerald"
            android:roundIcon="@mipmap/ic_launcher_theme_emerald"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityCyber"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_cyber"
            android:roundIcon="@mipmap/ic_launcher_theme_cyber"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Cyberpunk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivitySunset"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_sunset"
            android:roundIcon="@mipmap/ic_launcher_theme_sunset"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Sunset">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityCyan"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_cyan"
            android:roundIcon="@mipmap/ic_launcher_theme_cyan"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Cyan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityAmoled"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_amoled"
            android:roundIcon="@mipmap/ic_launcher_theme_amoled"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Amoled">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityRose"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_rose"
            android:roundIcon="@mipmap/ic_launcher_theme_rose"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Rose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityForest"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_forest"
            android:roundIcon="@mipmap/ic_launcher_theme_forest"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Forest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityIndigo"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_theme_indigo"
            android:roundIcon="@mipmap/ic_launcher_theme_indigo"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rhythmix.Indigo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Playback Service (foreground, keeps playing when app backgrounded) -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
