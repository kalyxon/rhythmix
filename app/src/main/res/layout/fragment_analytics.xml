<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_shell"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="18dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Stats"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero: today + all-time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="128dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_card_accent" android:padding="20dp"
                    android:layout_marginEnd="10dp" android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TODAY" android:textSize="10sp" android:textColor="@color/accent_on"
                        android:alpha="0.75" android:letterSpacing="0.14" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_today_listening"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0m" android:textColor="@color/accent_on"
                        android:textSize="32sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="128dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_card" android:padding="20dp"
                    android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ALL TIME" android:textSize="10sp" android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.14" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_total_listening"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0m" android:textColor="@color/text_primary"
                        android:textSize="32sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                </LinearLayout>
            </LinearLayout>

            <!-- KPI strip #1: Plays | Songs | Done% - one unified card, divided -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAYS" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tv_total_plays"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/accent"
                        android:textSize="21sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp" android:background="@color/hairline"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SONGS" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tv_unique_songs"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/violet"
                        android:textSize="21sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp" android:background="@color/hairline"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DONE %" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tv_completion_rate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/green"
                        android:textSize="21sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- KPI strip #2: Avg listen | Peak hour -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:paddingVertical="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG LISTEN" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tv_avg_session"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary"
                        android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp" android:background="@color/hairline"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PEAK HOUR" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="5dp"/>
                    <TextView android:id="@+id/tv_peak_hour"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/amber"
                        android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Listening heatmap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Listening Activity"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_heatmap_subtitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Less" android:textSize="9sp" android:textColor="@color/text_tertiary"
                            android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_0" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_1" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_2" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_3" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_4" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="More" android:textSize="9sp" android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/heatmap_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/heatmap_day_labels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/heatmap_month_labels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/heatmap_grid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Top Songs -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Most Played"
                android:textSize="17sp" android:textStyle="bold" android:letterSpacing="-0.01" android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp" android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_songs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
