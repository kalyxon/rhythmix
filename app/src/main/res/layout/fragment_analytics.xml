<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Stats"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero: today + all-time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_card_accent" android:padding="20dp"
                    android:layout_marginEnd="10dp" android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TODAY" android:textSize="9sp" android:textColor="#99000000"
                        android:letterSpacing="0.12" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_today_listening"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0m" android:textColor="@color/black"
                        android:textSize="34sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="listening" android:textSize="12sp" android:textColor="#88000000"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="130dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="20dp"
                    android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ALL TIME" android:textSize="9sp" android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_total_listening"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0m" android:textColor="@color/text_primary"
                        android:textSize="34sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="total" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3-stat row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="88dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="14dp"
                    android:layout_marginEnd="8dp" android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAYS" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_total_plays"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/accent"
                        android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="88dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="14dp"
                    android:layout_marginEnd="8dp" android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SONGS" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_unique_songs"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/violet"
                        android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="88dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="14dp"
                    android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DONE %" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_completion_rate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/green"
                        android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2-stat row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="20dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="14dp"
                    android:layout_marginEnd="8dp" android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG LISTEN" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_avg_session"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary"
                        android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" android:padding="14dp"
                    android:gravity="bottom">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PEAK HOUR" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_peak_hour"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/amber"
                        android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- GITHUB-STYLE LISTENING HEATMAP -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:padding="16dp">

                <!-- Heatmap header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Listening Activity"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_heatmap_subtitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                    <!-- Legend -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Less" android:textSize="9sp" android:textColor="@color/text_tertiary"
                            android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_0" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_1" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_2" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_3" android:layout_marginEnd="2dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_heatmap_4" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="More" android:textSize="9sp" android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Everything scrolls together: month labels + day labels + grid -->
                <HorizontalScrollView
                    android:id="@+id/heatmap_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <!-- Outer: day-label column (fixed) + right column (month row + grid) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Fixed day-of-week labels — built in code to match exact cell size -->
                        <LinearLayout
                            android:id="@+id/heatmap_day_labels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Right side: month labels row on top, grid below -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Month labels — same width as grid, scrolls with it -->
                            <LinearLayout
                                android:id="@+id/heatmap_month_labels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <!-- The week columns grid -->
                            <LinearLayout
                                android:id="@+id/heatmap_grid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Top Songs -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Most Played"
                android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp" android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_songs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
