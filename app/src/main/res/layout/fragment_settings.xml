<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_shell"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="120dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="2dp"
                android:text="Settings"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:text="Make Rhythmix feel like yours"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:text="APPEARANCE"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color theme"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp"
                    android:text="Choose an accent and background style"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeEmerald"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Olive Lime" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeCyber"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Cyberpunk Neon" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeSunset"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Sunset Amber" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeCyan"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Oceanic Cyan" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeAmoled"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="AMOLED Midnight" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeRose"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Rose Quartz" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeForest"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Forest Sage" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchThemeIndigo"
                    style="@style/Widget.Rhythmix.ThemeSwitch"
                    android:text="Indigo Dusk" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/hairline" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReduceMotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reduce motion"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/theme_switch_thumb"
                    app:trackTint="@color/theme_switch_track" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stops decorative loops, transitions, and list animations."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:text="YOUR MUSIC"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_accent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_folder"
                            app:tint="?attr/colorOnPrimary" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Music folder"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tv_folder_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_folder_uri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_flat"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRACKS"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tv_song_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_flat"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLAY EVENTS"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tv_event_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorSecondary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_folder"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="Change music folder"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rescan"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:text="Rescan folder"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_removed"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:text="Restore removed songs"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="?attr/colorSurfaceVariant"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"
                android:text="DATA &amp; PRIVACY"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_flat"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your listening data"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_data_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_data_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_data"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:text="Clear listening history"
                    android:textAllCaps="false"
                    android:textColor="@color/red"
                    app:backgroundTint="?attr/colorSurface"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
