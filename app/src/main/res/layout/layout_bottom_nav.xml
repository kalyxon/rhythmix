<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_scrim"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Mini player (shown when playing) - its own floating card -->
    <include
        android:id="@+id/mini_player"
        layout="@layout/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_nav_floating"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout android:id="@+id/nav_home"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView android:id="@+id/nav_home_icon"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_nav_home" app:tint="?attr/colorPrimary"
                android:contentDescription="@string/nav_home" />
            <View android:id="@+id/nav_home_indicator"
                android:layout_width="16dp" android:layout_height="3dp"
                android:layout_marginTop="5dp" android:background="@drawable/bg_play_btn"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_library"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView android:id="@+id/nav_library_icon"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_nav_library" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/nav_library" />
            <View android:id="@+id/nav_library_indicator"
                android:layout_width="16dp" android:layout_height="3dp"
                android:layout_marginTop="5dp" android:background="@drawable/bg_play_btn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_albums"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView android:id="@+id/nav_albums_icon"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_nav_albums" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/nav_albums" />
            <View android:id="@+id/nav_albums_indicator"
                android:layout_width="16dp" android:layout_height="3dp"
                android:layout_marginTop="5dp" android:background="@drawable/bg_play_btn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_analytics"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView android:id="@+id/nav_analytics_icon"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_nav_analytics" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/nav_analytics" />
            <View android:id="@+id/nav_analytics_indicator"
                android:layout_width="16dp" android:layout_height="3dp"
                android:layout_marginTop="5dp" android:background="@drawable/bg_play_btn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_settings"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView android:id="@+id/nav_settings_icon"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_nav_settings" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/nav_settings" />
            <View android:id="@+id/nav_settings_indicator"
                android:layout_width="16dp" android:layout_height="3dp"
                android:layout_marginTop="5dp" android:background="@drawable/bg_play_btn"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
