<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_mini_player"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:elevation="6dp">

    <ImageView
        android:id="@+id/mini_background_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:alpha="0.42"
        android:src="@drawable/ic_artwork_default" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mini_player_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/mini_art_container"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_artwork_placeholder"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/mini_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/song_artwork"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_artwork_default" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.rhythmix.app.ui.view.EqualizerVisualizerView
            android:id="@+id/miniEqualizer"
            android:layout_width="16dp"
            android:layout_height="18dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous track"
            android:padding="9dp"
            android:src="@drawable/ic_skip_prev"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_play_btn"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent_on" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next track"
            android:padding="9dp"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/miniProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:padding="0dp"
        android:indeterminate="false"
        android:clickable="false"
        android:focusable="false"
        android:progress="0"
        android:progressBackgroundTint="#558A9076"
        android:progressTint="@color/accent" />
</FrameLayout>
