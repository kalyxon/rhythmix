    <!-- Base Theme: Emerald (Spotify Lime Green) -->
    <style name="Theme.Rhythmix" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/emerald_accent</item>
        <item name="colorOnPrimary">@color/emerald_on</item>
        <item name="colorPrimaryContainer">@color/emerald_dim</item>
        <item name="colorOnPrimaryContainer">@color/emerald_light</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_theme_emerald</item>
        <item name="colorSecondary">@color/violet</item>
        <item name="colorSecondaryContainer">@color/violet_dim</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOutline">@color/surface_border</item>
        <item name="rhythmixSurfaceElevated">@color/elevated</item>
        <item name="rhythmixNavigationSurface">@color/nav_bg</item>
        <item name="rhythmixPlayerArtworkTint">@color/emerald_player_tint</item>
        <item name="rhythmixPlayerScrimStart">@color/emerald_player_scrim_start</item>
        <item name="rhythmixPlayerScrimCenter">@color/emerald_player_scrim_center</item>
        <item name="rhythmixPlayerScrimEnd">@color/emerald_player_scrim_end</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <item name="chipStyle">@style/Widget.Rhythmix.Chip</item>
    </style>

